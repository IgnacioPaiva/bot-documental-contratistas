# /opt/n8n/backup.env en el servidor (chmod 600). Nunca entra al repo.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Endpoint de jurisdicción UE: https://<account_id>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=<tu-bucket>
# Clave PÚBLICA de age (empieza con age1...). La privada queda en la Mac y en Contraseñas.
AGE_RECIPIENT=
